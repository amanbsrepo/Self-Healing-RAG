# "stub", "openai", "anthropic", or "auto".
# Stub mode is fully offline and uses a deterministic hashing embedder.
LLM_PROVIDER=stub

# "auto", "hashing", or "sentence_transformers".
# In auto mode, stub uses hashing and LLM modes use MiniLM.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

TOP_K=5
MAX_TOP_K=10

# Three total generations: one initial generation and at most two re-retrievals.
MAX_ATTEMPTS=3

CHUNK_SIZE_WORDS=100
CHUNK_OVERLAP_WORDS=20

DATA_DIR=data
DOCUMENTS_DIR=data/documents
FAISS_INDEX_PATH=data/faiss_index.bin
CHUNKS_METADATA_PATH=data/chunks.json
